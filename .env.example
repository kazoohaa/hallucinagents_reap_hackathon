# Server
DATABASE_URL=sqlite:///./agentpay.db
PAYMENT_MODE=mock
# Reserved for a future OpenRouter-powered planner. The deterministic demo never sends this value to the browser.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Only testnet/sandbox values belong here; never put production keys in this MVP.
X402_NETWORK=eip155:84532

# Reap Agentic Payments sandbox. Keep real values only in env.local (gitignored).
REAP_API_KEY=
REAP_BASE_URL=https://sandbox.api.reap.global
REAP_VERSION=2025-02-14
# Required for customer checkout. Must be an externally reachable HTTPS URL.
PUBLIC_RETURN_URL=https://your-public-domain.example/reap/return
